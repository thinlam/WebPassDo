MSSQL_SA_PASSWORD=Your_Strong_Password123
MSSQL_DATABASE=PassDoDb
MSSQL_PORT=1434

JWT_KEY=replace-with-a-long-secure-key-at-least-32-chars
JWT_ISSUER=PassDo.Api
JWT_AUDIENCE=PassDo.Client

# Google OAuth Client ID only (no client secret is used/stored server-side).
# Must match the frontend's VITE_GOOGLE_CLIENT_ID.
Google__ClientId=928362618296-jsj1jug968qu8isaj3iqotajd0rgt3jv.apps.googleusercontent.com

ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS=true
SWAGGER_ENABLED=true

# Host port mapping (container internal ports stay the same)
# Windows often blocks host port 8080 — use 8081 by default.
BACKEND_PORT=8081
FRONTEND_PORT=3000

# Frontend build-time API base. Prefer relative /api so Nginx can proxy.
VITE_API_BASE_URL=/api
